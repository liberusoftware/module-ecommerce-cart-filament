{
    "name": "liberusoftware/ecommerce-cart-filament",
    "description": "Filament administration for carts: what a shopper has chosen but not yet bought, read by the people who have to answer for it.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.1.0",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/liberusoftware/module-ecommerce-cart"
        }
    ],
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "filament/filament": "^5.0",
        "liberusoftware/module-manager": "^1.4",
        "liberusoftware/ecommerce-cart": "^0.1"
    },
    "require-dev": {
        "liberusoftware/ecommerce-cart": "^0.1",
        "liberusoftware/package-testbench": "^1.7",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Ecommerce\\Cart\\Filament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Ecommerce\\Cart\\Filament\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "ecommerce-cart-filament"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
